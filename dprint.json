{
  "lineWidth": 120,
  "newLineKind": "lf",
  "useTabs": false,
  "incremental": true,
  "typescript": {
    "deno": true,
    "lineWidth": 120
  },
  "json": { "deno": true },
  "yaml": {},
  "toml": {},
  "markdown": {
    "deno": true
  },
  "exec": {
    "cwd": "${configDir}",
    "commands": [
      { "command": "gofmt", "stdin": true, "exts": ["go"] },
      { "command": "dotnet csharpier format", "stdin": true, "exts": ["cs"] }
    ]
  },
  "includes": [
    "**/*.{cs,go,ts,tsx,js,jsx,cjs,mjs,json,yml,yaml,toml,md}"
  ],
  "excludes": [
    "**/.git",
    "**/.pixi",
    "CHANGELOG.md"
  ],
  "plugins": [
    "npm:@dprint/toml@0.8.0",
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.23.0",
    "npm:@dprint/markdown@0.23.1",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67"
  ]
}
